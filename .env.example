# Postgres connection string (Supabase/Neon/Railway free tiers all work well)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# WhatsApp Business Cloud API (Meta)
WA_PHONE_NUMBER_ID=1234567890
WA_ACCESS_TOKEN=EAAG...your_permanent_token
WA_API_VERSION=v20.0

# Behaviour tuning (optional — defaults shown)
LEADS_PER_RUN=5
DAILY_LEAD_CAP=20
MIN_DELAY_SECONDS=20
MAX_DELAY_SECONDS=60
MAX_RETRIES=3
